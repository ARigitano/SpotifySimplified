# Create an app at https://developer.spotify.com/dashboard to get a Client ID.
# No client secret is needed - this app uses the PKCE auth flow (safe for public/mobile apps).
SPOTIFY_CLIENT_ID=your_client_id_here

# Must exactly match a Redirect URI registered on the Spotify app dashboard.
# Use the loopback address for desktop testing.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# The playlist this app controls. Accepts a full URL, a URI, or a bare ID.
SPOTIFY_PLAYLIST_ID=https://open.spotify.com/playlist/your_playlist_id_here
